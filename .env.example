# Copy to .env and fill in. .env is git-ignored; never commit real values.

# LLM: claude_subscription (Claude Code login, default) | anthropic_api (needs ANTHROPIC_API_KEY)
HUB_LLM=claude_subscription

# Vault clone (for the missed-run check and, later, knowledge and vault writes)
VAULT_PATH=

# Local state
HUB_DB=data/hub.sqlite3
HUB_OUTBOX=data/outbox

# Email (ADR-H07). Without SMTP settings, emails are only saved to the outbox.
HUB_EMAIL_TO=
HUB_SMTP_HOST=smtp.gmail.com
HUB_SMTP_PORT=587
HUB_SMTP_USER=
HUB_SMTP_PASSWORD=   # Gmail: create an app password; never use the account password
HUB_UI_URL=http://localhost:8502

# Fin Analyst (agent #0) reads its own settings: VNSTOCK_API_KEY, SEC_USER_AGENT, FIN_AGENT_KB, ...
